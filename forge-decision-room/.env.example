# FORGE Decision Room — environment
#
# Copy to `.env` (git-ignored) and fill in. The key stays server-side only.

# Enable live AI turns. When unset/0, the chat runs the deterministic scripted
# turn (the room still answers; it just does not call the model).
FEATURE_AI_CHAT=0

# OpenAI-compatible endpoint and model. Defaults to the sciforium deployment of
# DeepSeek V4.1 Flash.
LLM_BASE_URL=https://api.sciforium.com/v1
LLM_MODEL=/deployments/506a9a37/deepseek-ai/DeepSeek-V4.1-Flash
LLM_API_KEY=
LLM_MAX_TOKENS=3000
LLM_TIMEOUT_MS=90000