# FORGE Decision Room V2 — server-only model configuration
#
# Copy to `.env` and provide the key. Never expose this key through VITE_* or
# browser code. V2 is pinned to the sciforium DeepSeek V4.1 Flash deployment.

FEATURE_AI_CHAT=1
LLM_BASE_URL=https://api.sciforium.com/v1
LLM_API_KEY=
LLM_MAX_TOKENS=3000
LLM_TIMEOUT_MS=90000

# Optional source availability flags. These do not grant write authority.
FEATURE_WEB_CONNECTOR=0
FEATURE_NOTION_CONNECTOR=0
FEATURE_ENTERPRISE_CONNECTORS=0
